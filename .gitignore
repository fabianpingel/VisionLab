# ============================================================================
# .gitignore — Welche Dateien sollen NICHT ins Git-Repository
# ============================================================================
# In Python wäre das vergleichbar mit .gitignore-Einträgen für __pycache__,
# .venv, etc. Hier sind die Node.js/Vite/TypeScript-typischen Pendants.

# Node-Module (entspricht .venv in Python — wird per `npm install` regeneriert)
node_modules/

# Build-Output von Vite (entspricht dem dist/ Ordner bei Python-Wheels)
dist/
dist-ssr/

# Lokale Umgebungsvariablen (KEINE Secrets ins Repo!)
.env.local
.env.*.local

# IDE-/Editor-Metadaten
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Betriebssystem-Artefakte
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test-Coverage-Reports
coverage/
.nyc_output/

# Vite-Cache (wird automatisch neu erstellt)
.vite/

# TypeScript-Inkrementelle-Build-Infos
*.tsbuildinfo

# Lokale HTTPS-Zertifikate (werden lokal generiert, nicht committet)
*.pem
certs/

# Python-Artefakte (für scripts/export_yolo.py)
__pycache__/
*.pyc
.venv/
.uv-cache/

# Modell-Quelldateien (.pt) — nur die exportierten .onnx werden committet
*.pt

# Zwischendateien des Export-Skripts (Ultralytics legt dort die .onnx ab,
# bevor sie nach public/models/ kopiert wird — siehe export_yolo.py).
scripts/*.onnx

# Lokale Cloudflare-/Tunnel-Configs
.cloudflared/

# Claude-Code-Settings (projekt-lokal, nicht teilen)
.claude/

# Temp-Ordner mit Logo-Originalen (werden in Phase 2 nach public/ kopiert)
temp/
