{
  "name": "visionlab",
  "private": true,
  "version": "0.1.0",
  "description": "Live-Objekterkennung als Demo-PWA — KI-Inferenz lokal im Browser via ONNX Runtime Web. Von PINGEL AI Solutions.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Fabian Pingel <fabian.pingel.work@gmail.com>",
